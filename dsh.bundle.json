    },
    {
      "id": "dsh-ielts-coach",
      "entry": "./src/dsh-ielts-coach/index.ts"
    },
    {
      "id": "dsh-identity-checklist",
      "entry": "./src/dsh-identity-checklist/index.ts"
    }
