  "description": "Five DSH plugins by Hermes for Ya-MiC: repo index, turn clock, quant backtest, audit draft, IELTS coach, identity checklist",
  "author": "Ya-MiC",
  "homepage": "https://github.com/Ya-MiC/hermes/tree/dsh-plugins",
  "license": "MIT",
  "dsh": {
    "minVersion": "*"
  },
  "plugins": [
